<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Lato:wght@400;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="admin-body">

<nav class="admin-nav">
  <div class="container-fluid d-flex justify-content-between align-items-center py-2 px-4">
    <span class="admin-brand">DD's <em>Batter</em> <small class="text-muted fw-normal">Admin</small></span>
    <div class="d-flex align-items-center gap-3">
      <a href="/" target="_blank" class="text-muted small"><i class="bi bi-box-arrow-up-right"></i> View Site</a>
      <form action="/admin/logout" method="POST" class="d-inline">
        <button class="btn btn-sm btn-outline-danger">Log Out</button>
      </form>
    </div>
  </div>
</nav>

<div class="container-fluid px-4 py-4">

  <div class="row g-3 mb-4">
    <% const statDefs = [
      {key:'all',        label:'All Orders',   color:'secondary'},
      {key:'pending',    label:'Pending',      color:'warning'},
      {key:'confirmed',  label:'Confirmed',    color:'info'},
      {key:'in_progress',label:'In Progress',  color:'primary'},
      {key:'ready',      label:'Ready',        color:'success'},
      {key:'delivered',  label:'Delivered',    color:'dark'},
      {key:'cancelled',  label:'Cancelled',    color:'danger'}
    ]; %>
    <% statDefs.forEach(s => { %>
      <div class="col-6 col-md-3 col-lg">
        <a href="/admin/orders?status=<%= s.key %>" class="text-decoration-none">
          <div class="admin-stat-card admin-stat-<%= s.color %> <%= filter===s.key?'active':'' %>">
            <div class="stat-num"><%= counts[s.key] || 0 %></div>
            <div class="stat-label"><%= s.label %></div>
          </div>
        </a>
      </div>
    <% }) %>
  </div>

  <div class="d-flex gap-2 mb-4 flex-wrap">
    <form action="/admin/orders" method="GET" class="d-flex gap-2 flex-wrap">
      <input type="hidden" name="status" value="<%= filter %>">
      <input type="text" name="search" class="form-control" placeholder="Search name, phone, order ref…" value="<%= search %>" style="max-width:280px">
      <button class="btn btn-outline-secondary" type="submit"><i class="bi bi-search"></i></button>
      <% if (search) { %><a href="/admin/orders?status=<%= filter %>" class="btn btn-outline-danger">Clear</a><% } %>
    </form>
  </div>

  <div class="card shadow-sm">
    <div class="card-body p-0">
      <% if (orders.length === 0) { %>
        <div class="p-4 text-center text-muted">No orders found.</div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-hover mb-0 admin-table">
            <thead>
              <tr>
                <th>Ref</th><th>Customer</th><th>Product</th>
                <th>Event Date</th><th>Delivery</th><th>Status</th><th>Placed</th><th></th>
              </tr>
            </thead>
            <tbody>
              <% orders.forEach(o => { %>
                <tr>
                  <td class="fw-bold text-brand">#<%= o.order_ref %></td>
                  <td>
                    <div class="fw-semibold"><%= o.customer_name %></div>
                    <div class="text-muted small"><%= o.customer_phone %></div>
                  </td>
                  <td><span class="badge product-badge"><%= o.product_type.replace('_',' ') %></span></td>
                  <td><%= o.event_date %></td>
                  <td><%= o.delivery_method === 'delivery' ? '🚗 Delivery' : '🏠 Pickup' %></td>
                  <td><span class="badge status-badge status-<%= o.status %>"><%= o.status.replace('_',' ') %></span></td>
                  <td class="text-muted small"><%= o.created_at.slice(0,10) %></td>
                  <td><a href="/admin/orders/<%= o.id %>" class="btn btn-sm btn-outline-brand">View</a></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

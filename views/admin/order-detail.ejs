<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Lato:wght@400;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="admin-body">

<nav class="admin-nav">
  <div class="container-fluid d-flex justify-content-between align-items-center py-2 px-4">
    <span class="admin-brand">DD's <em>Batter</em> <small class="text-muted fw-normal">Admin</small></span>
    <div class="d-flex gap-3">
      <a href="/admin/orders" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left"></i> All Orders</a>
      <form action="/admin/logout" method="POST" class="d-inline">
        <button class="btn btn-sm btn-outline-danger">Log Out</button>
      </form>
    </div>
  </div>
</nav>

<div class="container py-4" style="max-width:800px">
  <div class="d-flex justify-content-between align-items-start mb-4 flex-wrap gap-2">
    <div>
      <h4 class="fw-bold mb-0">Order <span class="text-brand">#<%= order.order_ref %></span></h4>
      <small class="text-muted">Placed: <%= order.created_at %></small>
    </div>
    <span class="badge status-badge status-<%= order.status %> fs-6"><%= order.status.replace('_',' ') %></span>
  </div>

  <div class="row g-4">
    <div class="col-md-6">
      <div class="card shadow-sm h-100">
        <div class="card-header admin-card-header"><i class="bi bi-person me-2"></i>Customer</div>
        <div class="card-body">
          <p class="mb-1"><strong><%= order.customer_name %></strong></p>
          <p class="mb-1 text-muted"><i class="bi bi-envelope me-1"></i><%= order.customer_email %></p>
          <p class="mb-0 text-muted"><i class="bi bi-telephone me-1"></i><%= order.customer_phone %></p>
        </div>
      </div>
    </div>

    <div class="col-md-6">
      <div class="card shadow-sm h-100">
        <div class="card-header admin-card-header"><i class="bi bi-truck me-2"></i>Delivery</div>
        <div class="card-body">
          <p class="mb-1"><strong><%= order.delivery_method === 'delivery' ? '🚗 Delivery' : '🏠 Pickup' %></strong></p>
          <% if (order.delivery_method === 'delivery' && order.delivery_address) { %>
            <p class="mb-1 text-muted"><%= order.delivery_address %></p>
          <% } %>
          <p class="mb-0">Event Date: <strong class="text-brand"><%= order.event_date %></strong></p>
        </div>
      </div>
    </div>

    <div class="col-12">
      <div class="card shadow-sm">
        <div class="card-header admin-card-header"><i class="bi bi-bag me-2"></i>Order Details</div>
        <div class="card-body">
          <table class="table table-sm table-borderless mb-0">
            <tr><td class="text-muted" style="width:35%">Product</td><td><strong><%= order.product_type.replace('_',' ').replace(/\b\w/g,c=>c.toUpperCase()) %></strong></td></tr>
            <% if (order.size)        { %><tr><td class="text-muted">Size / Qty</td><td><%= order.size %></td></tr><% } %>
            <% if (order.flavor)      { %><tr><td class="text-muted">Flavor</td><td><%= order.flavor %></td></tr><% } %>
            <% if (order.icing_type)  { %><tr><td class="text-muted">Icing</td><td><%= order.icing_type %></td></tr><% } %>
            <% if (order.icing_color) { %><tr><td class="text-muted">Icing Color</td><td><%= order.icing_color %></td></tr><% } %>
            <% if (order.layers)      { %><tr><td class="text-muted">Layers</td><td><%= order.layers %></td></tr><% } %>
            <% if (order.inscription) { %><tr><td class="text-muted">Inscription</td><td><%= order.inscription %></td></tr><% } %>
            <% if (order.custom_details) { %><tr><td class="text-muted" style="vertical-align:top">Custom Details</td><td><%= order.custom_details %></td></tr><% } %>
            <% if (items.length > 0) { %>
              <tr><td class="text-muted" style="vertical-align:top">Small Chops</td>
                <td><ul class="mb-0 ps-3"><% items.forEach(i => { %><li><%= i.name %> &times; <%= i.qty %><% if(i.spice){ %> — <%= i.spice %><% } %></li><% }) %></ul></td>
              </tr>
            <% } %>
            <% if (order.special_notes) { %><tr><td class="text-muted" style="vertical-align:top">Notes</td><td><%= order.special_notes %></td></tr><% } %>
          </table>
        </div>
      </div>
    </div>

    <div class="col-12">
      <div class="card shadow-sm">
        <div class="card-header admin-card-header"><i class="bi bi-pencil-square me-2"></i>Update Order</div>
        <div class="card-body">
          <form action="/admin/orders/<%= order.id %>/status" method="POST">
            <div class="row g-3 align-items-end">
              <div class="col-md-4">
                <label class="form-label">Status</label>
                <select name="status" class="form-select">
                  <% ['pending','confirmed','in_progress','ready','delivered','cancelled'].forEach(s => { %>
                    <option value="<%= s %>" <%=order.status===s?'selected':''%>><%= s.replace('_',' ').replace(/\b\w/g,c=>c.toUpperCase()) %></option>
                  <% }) %>
                </select>
              </div>
              <div class="col-md-6">
                <label class="form-label">Admin Notes</label>
                <input type="text" name="admin_notes" class="form-control"
                  placeholder="e.g. Quoted ₦15,000 via DM" value="<%= order.admin_notes||'' %>">
              </div>
              <div class="col-md-2">
                <button type="submit" class="btn btn-brand-primary w-100">Update</button>
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

<%- include('partials/header') %>

<!-- Hero Section -->
<section class="hero-section">
  <div class="hero-overlay">
    <div class="container text-center">
      <p class="hero-sub">Handcrafted with Love</p>
      <h1 class="hero-title">DD's <em>Batter</em></h1>
      <p class="hero-tagline">Cakes &bull; Small Chops &bull; Pastries</p>
      <div class="d-flex gap-3 justify-content-center flex-wrap mt-4">
        <a href="/order" class="btn btn-hero-primary">Place an Order</a>
        <a href="/menu"  class="btn btn-hero-outline">View Our Menu</a>
      </div>
    </div>
  </div>
</section>

<!-- What We Offer -->
<section class="py-5">
  <div class="container">
    <div class="text-center mb-5">
      <h2 class="section-title">What We Offer</h2>
      <p class="section-sub">Every bite made to order, every occasion made special.</p>
    </div>
    <div class="row g-4">
      <div class="col-md-3 col-sm-6">
        <div class="offer-card text-center h-100">
          <div class="offer-icon">🎂</div>
          <h5>Celebration Cakes</h5>
          <p>6" to 12" tiered cakes with your choice of flavor, icing and inscription.</p>
          <a href="/order/cake" class="btn btn-sm btn-outline-brand mt-auto">Order Now</a>
        </div>
      </div>
      <div class="col-md-3 col-sm-6">
        <div class="offer-card text-center h-100">
          <div class="offer-icon">🧁</div>
          <h5>Cupcakes</h5>
          <p>Beautifully frosted cupcakes in half dozens or full dozens — any flavor.</p>
          <a href="/order/cupcakes" class="btn btn-sm btn-outline-brand mt-auto">Order Now</a>
        </div>
      </div>
      <div class="col-md-3 col-sm-6">
        <div class="offer-card text-center h-100">
          <div class="offer-icon">🥟</div>
          <h5>Small Chops</h5>
          <p>Nigerian-style samosas, spring rolls, puff puff & pies — chicken, beef or veggie.</p>
          <a href="/order/small-chops" class="btn btn-sm btn-outline-brand mt-auto">Order Now</a>
        </div>
      </div>
      <div class="col-md-3 col-sm-6">
        <div class="offer-card text-center h-100">
          <div class="offer-icon">✨</div>
          <h5>Custom Cakes</h5>
          <p>Fully bespoke designs — themed, sculpted, or tiered. You dream it, we bake it.</p>
          <a href="/order/custom" class="btn btn-sm btn-outline-brand mt-auto">Request a Quote</a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- How It Works -->
<section class="how-section py-5">
  <div class="container">
    <div class="text-center mb-5">
      <h2 class="section-title">How It Works</h2>
    </div>
    <div class="row g-4 text-center">
      <div class="col-md-3">
        <div class="step-circle">1</div>
        <h6 class="mt-3 fw-bold">Choose Your Product</h6>
        <p class="text-muted small">Pick from cakes, cupcakes, small chops or custom.</p>
      </div>
      <div class="col-md-3">
        <div class="step-circle">2</div>
        <h6 class="mt-3 fw-bold">Customize Your Order</h6>
        <p class="text-muted small">Select size, flavor, icing, and all the details.</p>
      </div>
      <div class="col-md-3">
        <div class="step-circle">3</div>
        <h6 class="mt-3 fw-bold">We Confirm & Quote</h6>
        <p class="text-muted small">We'll reach out to confirm and share your price.</p>
      </div>
      <div class="col-md-3">
        <div class="step-circle">4</div>
        <h6 class="mt-3 fw-bold">Pickup or Delivery</h6>
        <p class="text-muted small">Collect your order or have it delivered to you.</p>
      </div>
    </div>
    <div class="text-center mt-5">
      <a href="/order" class="btn btn-brand-primary">Start Your Order</a>
    </div>
  </div>
</section>

<!-- Notice Banner -->
<section class="notice-banner py-3">
  <div class="container text-center">
    <i class="bi bi-clock-history me-2"></i>
    <strong>Please Note:</strong> All orders require a minimum of <strong>3 days notice</strong>.
    For urgent requests, message us on
    <a href="https://instagram.com/dds_batter" target="_blank" class="instagram-inline">@dds_batter</a>.
  </div>
</section>

<%- include('partials/footer') %>

<%- include('partials/header') %>

<div class="page-banner text-center py-5">
  <h1 class="page-banner-title">Get in Touch</h1>
  <p class="page-banner-sub">We'd love to hear from you.</p>
</div>

<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-6 text-center">
      <div class="contact-card">
        <div class="contact-ig-icon"><i class="bi bi-instagram"></i></div>
        <h4 class="mt-3">Find us on Instagram</h4>
        <p class="text-muted">Send us a DM for urgent inquiries, order questions, or just to say hello.</p>
        <a href="https://instagram.com/dds_batter" target="_blank" class="btn btn-brand-primary btn-lg mt-2">
          <i class="bi bi-instagram me-2"></i>@dds_batter
        </a>
      </div>

      <div class="mt-5 p-4 bg-cream rounded">
        <h5 class="fw-bold">Ready to order?</h5>
        <p class="text-muted">Skip the DM and place your order directly through our order form — it takes less than 3 minutes.</p>
        <a href="/order" class="btn btn-outline-brand">Place an Order</a>
      </div>

      <div class="mt-4 text-muted small">
        <i class="bi bi-clock me-1"></i> Orders require at least <strong>3 days</strong> notice.
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
